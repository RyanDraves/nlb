git_override(
    module_name = "gazelle_rust",
    # BCR 0.1.0 predates the rules_rust 0.71.0 fix (upstream commit 49a15fdc),
    # so track main. The patch works around gazelle_rust shipping no
    # crate_universe lockfile, which rules_rust >=0.71.1 requires of non-root
    # modules ("Transitive crate_universe repositories must ship a
    # `lockfile = ...`"). See the patch header for the full rationale.
    #
    # REGENERATING THE PATCH (needed whenever `commit` is bumped, or when
    # gazelle_rust changes its own Cargo.toml/Cargo.lock):
    #
    #   git clone https://github.com/Calsign/gazelle_rust.git /tmp/gazelle_rust
    #   cd /tmp/gazelle_rust && git checkout <commit>
    #   # add `lockfile = "//:Cargo.Bazel.lock"` to the crate.from_cargo call
    #   # for `gazelle_rust_crates` in its MODULE.bazel, then:
    #   touch Cargo.Bazel.lock
    #   CARGO_BAZEL_REPIN=1 bazel query '@gazelle_rust_crates//:all' \
    #       --lockfile_mode=update
    #   git add -f Cargo.Bazel.lock MODULE.bazel
    #   git diff --cached > <this repo>/bzl/deps/patches/gazelle_rust_lockfile.patch
    #
    # The empty `touch` is required first: rules_rust reads the lockfile as JSON
    # (its "can be empty" docstring is wrong for this path), and the repin is
    # what fills it in. `--lockfile_mode=update` is needed because editing their
    # MODULE.bazel invalidates their checked-in MODULE.bazel.lock.
    commit = "747482bf",
    patch_strip = 1,
    patches = ["//bzl/deps/patches:gazelle_rust_lockfile.patch"],
    remote = "https://github.com/Calsign/gazelle_rust.git",
)

