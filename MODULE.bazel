rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    # Every first-party rust target sets `edition` explicitly (all on 2024);
    # this default also covers targets in dependency modules that don't set one,
    # notably gazelle_rust's parser, which uses let chains (2024-only). A
    # non-root module's `rust.toolchain(edition = ...)` is ignored — the root's
    # wins — so this must stay >= 2024 for gazelle_rust to compile.
    edition = "2024",
    # Note: this REPLACES the default extra triples, so the wasm targets (used by
    # the brm web client) must be listed explicitly alongside the Linux triples
    # we add for cross-compiling the server into its container image.
    extra_target_triples = [
        "wasm32-unknown-unknown",
        "wasm32-wasip1",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
    ],
    # Pin nightly to a date before rustc added `--fix-cortex-a53-843419` to the
    # aarch64-unknown-linux-gnu link args. The hermetic Zig cc used to link the
    # cross-compiled Linux server rejects that arg ("unsupported linker arg"),
    # and Zig hasn't added support even as of 0.16.0 — the fix is wrapper-side
    # (cargo-zigbuild), not in any released hermetic_cc_toolchain. Revisit/unpin
    # once a toolchain that strips the arg is available.
    versions = ["nightly/2026-06-04"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

register_toolchains(
    "@rules_rust_wasm_bindgen//:default_wasm_bindgen_toolchain",
)

# Hermetic Zig-based C toolchains for cross-compiling the Rust server to Linux
# (tokio links libc, so unlike Go it needs a cross cc toolchain). NOT registered
# globally — that would override the default/RBE cc toolchains for every Linux
# build. Instead `--config=image` in .bazelrc adds them via --extra_toolchains,
# so only image builds (which compile no other Linux C/C++) use Zig.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

zig_toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig_toolchains, "zig_sdk")

crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
)

# wasm_split_helpers (a leptos transitive) expands a proc-macro that reads
# CARGO_MANIFEST_PATH, which cargo sets but Bazel does not; any stable string
# works (it's only a symbol-name stamp).
crate.annotation(
    crate = "wasm_split_helpers",
    repositories = ["crates"],
    rustc_env = {"CARGO_MANIFEST_PATH": "wasm_split_helpers"},
)

# ring (via reqwest's rustls-tls) compiles C crypto through cc-rs, which passes
# the Rust triple `x86_64-unknown-linux-gnu` as clang `--target`. The hermetic
# Zig cc rejects that vendor form ("UnknownOperatingSystem"); appending a
# Zig-native `-target` in CFLAGS wins (last flag) and lets ring cross-compile.
crate.annotation(
    build_script_env = {
        "CFLAGS_x86_64_unknown_linux_gnu": "-target x86_64-linux-gnu",
        "CFLAGS_aarch64_unknown_linux_gnu": "-target aarch64-linux-gnu",
    },
    crate = "ring",
    repositories = ["crates"],
)

# One hub for every third-party Rust crate in the repo, resolved from the single
# //:Cargo.toml. Keeping it to ONE hub is what lets //lrb libraries take
# third-party deps at all: crates from separate hubs are distinct Bazel targets
# whose types never unify, so shared code could otherwise only ever be linked
# into a single app. Repin with:
#   CARGO_BAZEL_REPIN=1 bazel query '@crates//:all'
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")

