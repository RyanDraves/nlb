{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on Saturday"],
  "timezone": "America/New_York",
  "vulnerabilityAlerts": {
    "groupName": "security updates",
    "schedule": ["at any time"],
    "vulnerabilityFixStrategy": "highest"
  },
  "packageRules": [
    {
      "description": "Ignore own GHCR images (built from this repo)",
      "enabled": false,
      "matchPackageNames": [
        "/^ghcr\\.io/ryandraves//"
      ]
    },
    {
      "description": "Group all Bazel module updates into one PR",
      "matchManagers": ["bazel-module"],
      "groupName": "bazel modules",
      "automerge": false
    },
    {
      "description": "Group GitHub Actions updates into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": false
    },
    {
      "description": "Group Docker Compose image updates into one PR",
      "matchManagers": ["docker-compose"],
      "groupName": "docker service images",
      "automerge": false
    },
    {
      "description": "Do not update the pip-compiled lockfile directly; CI regenerates it via Bazel",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["requirements_lock.txt"],
      "enabled": false
    },
    {
      "description": "Group all Python dependency updates into one PR",
      "matchManagers": ["pip_requirements"],
      "groupName": "python dependencies",
      "automerge": false
    },
    {
      "description": "Group all Go module updates into one PR; CI runs `go mod tidy` via Bazel to fix go.sum",
      "matchManagers": ["gomod"],
      "groupName": "go modules",
      "automerge": false
    },
    {
      "description": "Bump package.json ranges (not just the lockfile) on in-range updates",
      "matchManagers": ["npm"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Group all npm/pnpm dependency updates into one PR",
      "matchManagers": ["npm"],
      "groupName": "npm dependencies",
      "automerge": false
    },
    {
      "description": "Bump Cargo.toml ranges (not just the lockfile) on in-range updates",
      "matchManagers": ["cargo"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Group all Rust crate updates into one PR; CI regenerates Cargo.lock via Bazel",
      "matchManagers": ["cargo"],
      "groupName": "rust crates",
      "automerge": false
    },
    {
      "description": "wasm-bindgen is pinned to the CLI bundled by rules_rust_wasm_bindgen; bumping it alone breaks the wasm builds",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["wasm-bindgen"],
      "enabled": false
    }
  ]
}
